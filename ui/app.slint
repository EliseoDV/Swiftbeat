import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { State, Api, Img, Fmt, TrackRow, Card, Shelf, LyricLine } from "state.slint";
import { TopBar, Sidebar, PlayerBar, RightPanel } from "shell.slint";
import { HomePage, SearchPage, CollectionPage, ArtistPage, SettingsPage, LoginScreen, LoadingScreen } from "pages.slint";

export { State, Api, Img, TrackRow, Card, Shelf, LyricLine }

export component AppWindow inherits Window {
    title: "Swiftbeat";
    icon: @image-url("../assets/swiftbeat.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    init => {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                keys.focus();
                return accept;
            }
            if State.screen != 2 {
                return reject;
            }
            if event.text == " " {
                Api.toggle-play();
                return accept;
            }
            if event.modifiers.control && event.text == Key.RightArrow {
                Api.next();
                return accept;
            }
            if event.modifiers.control && event.text == Key.LeftArrow {
                Api.prev();
                return accept;
            }
            if event.modifiers.alt && event.text == Key.LeftArrow {
                Api.back();
                return accept;
            }
            if event.modifiers.alt && event.text == Key.RightArrow {
                Api.forward();
                return accept;
            }
            return reject;
        }

        if State.screen == 0: LoadingScreen { }
        if State.screen == 1: LoginScreen { }
        if State.screen == 2: VerticalLayout {
            padding: 8px;
            spacing: 8px;
            TopBar { }
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                Sidebar {
                    width: root.width > 1150px ? 320px : 260px;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.panel;
                    border-radius: Theme.radius-panel;
                    clip: true;
                    if State.page == 0: HomePage { }
                    if State.page == 1: SearchPage { }
                    if State.page == 2: CollectionPage { }
                    if State.page == 3: ArtistPage { }
                    if State.page == 4: SettingsPage { }
                }
                if State.right-panel != 0: RightPanel {
                    width: 320px;
                }
            }
            PlayerBar { }
        }

        if State.toast != "": Rectangle {
            y: root.height - 148px;
            width: toast-row.preferred-width;
            height: 44px;
            border-radius: 22px;
            background: Theme.toast;
            border-width: 1px;
            border-color: Theme.border-strong;
            toast-row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 20px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 18px;
                        height: 18px;
                        data: Icons.info;
                        color: Theme.accent;
                    }
                }
                Text {
                    text: State.toast;
                    color: Theme.text;
                    font-size: Theme.font-md;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Capa invisible sobre toda la ventana: depende de State.repaint, así que al
    // cambiarlo Slint la repinta entera (ver src/repaint.rs). Con x/y explícitos
    // para que el compilador no la elimine por no dibujar nada.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: State.repaint < 0 ? #000000 : transparent;
    }
}
