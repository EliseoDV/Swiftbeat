import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { State, Api, Img, Card, TrackRow, Shelf } from "state.slint";

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> stroke: true;
    in property <length> size: 18px;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> show-dot;
    in property <color> base: Theme.subtext;
    callback clicked;
    width: root.size + 14px;
    height: root.size + 14px;
    border-radius: self.height / 2;
    background: !root.enabled ? transparent : ta.pressed ? #ffffff1f : ta.has-hover ? #ffffff12 : transparent;
    animate background { duration: Theme.fast; }
    Icon {
        width: root.size;
        height: root.size;
        data: root.icon;
        stroke: root.stroke;
        color: !root.enabled ? Theme.disabled : root.active ? (ta.has-hover ? Theme.accent-hover : Theme.accent) : (ta.has-hover ? Theme.text : root.base);
    }
    if root.show-dot && root.active: Rectangle {
        y: root.height - 5px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

export component CircleButton inherits Rectangle {
    in property <string> icon;
    in property <bool> stroke: true;
    in property <length> size: 32px;
    in property <length> icon-size: 16px;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <color> bg: Theme.surface;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: !root.enabled ? root.bg : ta.pressed ? Theme.elevated : ta.has-hover ? Theme.elevated-hover : root.bg;
    animate background { duration: Theme.fast; }
    Icon {
        width: root.icon-size;
        height: root.icon-size;
        data: root.icon;
        stroke: root.stroke;
        color: !root.enabled ? Theme.disabled : root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.subtext;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

export component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <length> size: 48px;
    in property <color> bg: Theme.accent;
    in property <color> hover-bg: Theme.accent-hover;
    in property <color> icon-color: Theme.on-accent;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.pressed ? root.bg.darker(0.15) : ta.has-hover ? root.hover-bg : root.bg;
    animate background { duration: Theme.fast; }
    Icon {
        // El triángulo del play se desplaza un poco para que parezca centrado.
        x: (root.width - self.width) / 2 + (root.playing ? 0px : root.size * 0.03);
        width: root.size * 0.42;
        height: root.size * 0.42;
        data: root.playing ? Icons.pause : Icons.play;
        stroke: false;
        color: root.icon-color;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Tres puntos que laten. Solo existe mientras hay algo cargando, así que la
// animación no despierta la UI el resto del tiempo.
export component Spinner {
    in property <length> size: 28px;
    in property <color> color: Theme.accent;
    property <float> t: Math.mod(animation-tick() / 1ms, 1200) / 1200;
    width: root.size;
    height: root.size / 3;
    for d[i] in 3: Rectangle {
        x: i * root.size * 0.38;
        y: (root.height - self.height) / 2;
        width: root.size * 0.24;
        height: self.width;
        border-radius: self.width / 2;
        background: root.color;
        opacity: 0.25 + 0.75 * (0.5 + 0.5 * Math.sin(root.t * 360deg - i * 70deg));
    }
}

// Mensaje centrado para listas vacías, errores y estados de espera.
export component EmptyState inherits VerticalLayout {
    in property <string> icon: Icons.note;
    in property <string> title;
    in property <string> body;
    in property <bool> busy;
    alignment: center;
    spacing: 10px;
    padding: 24px;
    HorizontalLayout {
        alignment: center;
        if root.busy: VerticalLayout {
            alignment: center;
            height: 64px;
            Spinner { size: 36px; }
        }
        if !root.busy: Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            Icon {
                width: 28px;
                height: 28px;
                data: root.icon;
                color: Theme.subtext;
            }
        }
    }
    if root.title != "": Text {
        text: root.title;
        font-size: Theme.font-lg;
        font-weight: 700;
        color: Theme.text;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.body != "": Text {
        text: root.body;
        font-size: Theme.font-md;
        color: Theme.subtext;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component Cover inherits Rectangle {
    in property <string> url;
    in property <int> px: 64;
    in property <bool> round;
    in property <bool> liked-tile;
    in property <length> radius: Theme.radius-cover;
    border-radius: root.round ? root.width / 2 : root.radius;
    clip: true;
    background: root.liked-tile ? @linear-gradient(135deg, Theme.liked-from 0%, Theme.liked-to 100%) : Theme.elevated;
    if root.url == "" && !root.liked-tile: Icon {
        width: root.width * 0.38;
        height: root.width * 0.38;
        data: Icons.note;
        stroke: false;
        color: Theme.muted;
    }
    if root.liked-tile: Icon {
        width: root.width * 0.42;
        height: root.width * 0.42;
        data: Icons.heart;
        stroke: false;
        color: #ffffff;
    }
    if root.url != "": Image {
        width: 100%;
        height: 100%;
        // Tamaño negativo: Rust devuelve la imagen ya recortada en círculo (ver images.rs).
        source: Img.get(root.url, root.round ? -root.px : root.px, Img.epoch);
        image-fit: cover;
    }
}

export component CardView inherits Rectangle {
    in property <Card> card;
    property <bool> ctx-playing: State.ctx-uri == root.card.uri && State.playing;
    property <bool> hot: ta.has-hover || root.ctx-playing;
    border-radius: Theme.radius-card;
    background: ta.pressed ? Theme.elevated : ta.has-hover ? Theme.card-hover : transparent;
    animate background { duration: Theme.fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Api.navigate(root.card.kind, root.card.uri);
        }
        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            alignment: start;
            Rectangle {
                height: root.width - 24px;
                Cover {
                    width: 100%;
                    height: 100%;
                    url: root.card.image;
                    px: 200;
                    round: root.card.kind == 1;
                    liked-tile: root.card.kind == 3;
                    radius: Theme.radius-card;
                }
                PlayButton {
                    x: parent.width - self.width - 8px;
                    y: parent.height - self.height - (root.hot ? 8px : 0px);
                    opacity: root.hot ? 1 : 0;
                    animate opacity, y { duration: Theme.normal; easing: ease-out; }
                    playing: root.ctx-playing;
                    clicked => {
                        if State.ctx-uri == root.card.uri {
                            Api.toggle-play();
                        } else {
                            Api.play-card(root.card.kind, root.card.uri);
                        }
                    }
                }
            }
            Rectangle { height: 6px; }
            Text {
                text: root.card.title;
                color: root.ctx-playing ? Theme.accent : Theme.text;
                font-size: Theme.font-md + 1px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.card.subtitle;
                color: Theme.subtext;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }
    }
}

export component ShelfView inherits VerticalLayout {
    in property <Shelf> shelf;
    // Las tarjetas tienen 12px de relleno: se extienden 12px a cada lado para que
    // la portada quede alineada con el título de la sección.
    property <int> cols: max(2, Math.floor((self.width + 32px) / 188px));
    property <length> card-w: (self.width + 24px - (self.cols - 1) * 8px) / self.cols;
    spacing: 6px;
    Text {
        text: root.shelf.title;
        font-size: Theme.font-section;
        font-weight: 700;
        color: Theme.text;
        overflow: elide;
    }
    Rectangle {
        height: root.card-w + 56px;
        for c[i] in root.shelf.items: CardView {
            visible: i < root.cols;
            x: i * (root.card-w + 8px) - 12px;
            y: 0;
            width: root.card-w;
            height: parent.height;
            card: c;
        }
    }
}

// Texto enlazado a un álbum (kind 0) o artista (kind 1): se aclara y subraya al pasar el ratón.
export component Link {
    in property <string> text;
    in property <string> uri;
    in property <int> kind;
    in property <color> color: Theme.subtext;
    in property <length> font-size: Theme.font-sm;
    min-width: 0px;
    preferred-width: label.preferred-width;
    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: link-ta.has-hover && root.uri != "" ? Theme.text : root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
    if link-ta.has-hover && root.uri != "": Rectangle {
        x: 0;
        y: root.height / 2 + root.font-size * 0.62;
        width: min(label.preferred-width, root.width);
        height: 1px;
        background: Theme.text;
    }
    link-ta := TouchArea {
        mouse-cursor: root.uri != "" ? pointer : default;
        clicked => {
            if root.uri != "" {
                Api.navigate(root.kind, root.uri);
            }
        }
    }
}

export component TrackItem inherits Rectangle {
    in property <TrackRow> track;
    in property <int> source;
    in property <bool> show-album: true;
    in property <bool> show-cover: true;
    in property <bool> compact;
    property <bool> current: root.track.uri == State.np-uri;
    property <bool> liked: Api.is-liked(root.track.uri, State.liked-epoch);
    property <color> secondary: ta.has-hover ? Theme.text : Theme.subtext;
    height: 56px;
    border-radius: Theme.radius-row;
    background: ta.pressed ? Theme.row-active : ta.has-hover ? Theme.row-hover : transparent;
    animate background { duration: Theme.fast; }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Añadir a la cola";
                activated => {
                    Api.enqueue(root.source, root.track.index);
                }
            }
            MenuItem {
                title: root.liked ? "Quitar de Tus me gusta" : "Guardar en Tus me gusta";
                activated => {
                    Api.toggle-like(root.track.uri);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Ir al artista";
                enabled: root.track.artist-uri != "";
                activated => {
                    Api.navigate(1, root.track.artist-uri);
                }
            }
            MenuItem {
                title: "Ir al álbum";
                enabled: root.track.album-uri != "";
                activated => {
                    Api.navigate(0, root.track.album-uri);
                }
            }
            Menu {
                title: "Añadir a playlist";
                for p in State.my-playlists: MenuItem {
                    title: p.title;
                    activated => {
                        Api.add-to-playlist(root.source, root.track.index, p.uri);
                    }
                }
            }
        }
        ta := TouchArea {
            double-clicked => {
                Api.play-row(root.source, root.track.index);
            }
            HorizontalLayout {
                padding-left: root.compact ? 8px : 16px;
                padding-right: root.compact ? 8px : 16px;
                spacing: root.compact ? 10px : 16px;
                if !root.compact: Rectangle {
                    width: 24px;
                    if !ta.has-hover && root.current && State.playing: Icon {
                        x: parent.width - self.width;
                        width: 16px;
                        height: 16px;
                        data: Icons.bars;
                        color: Theme.accent;
                    }
                    if !ta.has-hover && !(root.current && State.playing): Text {
                        width: 100%;
                        height: 100%;
                        text: root.track.index + 1;
                        color: root.current ? Theme.accent : Theme.subtext;
                        font-size: Theme.font-md + 1px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    if ta.has-hover: IconButton {
                        x: parent.width - self.width + 7px;
                        icon: root.current && State.playing ? Icons.pause : Icons.play;
                        stroke: false;
                        size: 14px;
                        base: Theme.text;
                        clicked => {
                            if root.current {
                                Api.toggle-play();
                            } else {
                                Api.play-row(root.source, root.track.index);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 3;
                    min-width: 0px;
                    preferred-width: 0px;
                    if root.show-cover: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            Cover {
                                width: 100%;
                                height: 100%;
                                url: root.track.image;
                                px: 40;
                                radius: 4px;
                            }
                            // Sin columna de número (búsqueda, cola) el play va sobre la portada.
                            if root.compact && (ta.has-hover || (root.current && State.playing)): Rectangle {
                                border-radius: 4px;
                                background: #000000a6;
                                if !ta.has-hover: Icon {
                                    width: 16px;
                                    height: 16px;
                                    data: Icons.bars;
                                    color: Theme.accent;
                                }
                                if ta.has-hover: IconButton {
                                    icon: root.current && State.playing ? Icons.pause : Icons.play;
                                    stroke: false;
                                    size: 16px;
                                    base: #ffffff;
                                    clicked => {
                                        if root.current {
                                            Api.toggle-play();
                                        } else {
                                            Api.play-row(root.source, root.track.index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.track.title;
                            color: root.current ? Theme.accent : Theme.text;
                            font-size: Theme.font-md + 1px;
                            font-weight: root.current ? 600 : 400;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            if root.track.explicit: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 15px;
                                    height: 15px;
                                    border-radius: 3px;
                                    background: Theme.subtext;
                                    Text {
                                        text: "E";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.panel;
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                min-width: 0px;
                                Link {
                                    text: root.track.artists;
                                    uri: root.track.artist-uri;
                                    kind: 1;
                                    color: root.secondary;
                                }
                                if root.track.artist2 != "": Text {
                                    text: ", ";
                                    color: root.secondary;
                                    font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                }
                                if root.track.artist2 != "": Link {
                                    text: root.track.artist2;
                                    uri: root.track.artist2-uri;
                                    kind: 1;
                                    color: root.secondary;
                                }
                                if root.track.artist3 != "": Text {
                                    text: ", ";
                                    color: root.secondary;
                                    font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                }
                                if root.track.artist3 != "": Link {
                                    text: root.track.artist3;
                                    uri: root.track.artist3-uri;
                                    kind: 1;
                                    color: root.secondary;
                                }
                                if root.track.more-artists: Text {
                                    text: ", …";
                                    color: root.secondary;
                                    font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                if root.show-album: Rectangle {
                    horizontal-stretch: 2;
                    min-width: 0px;
                    preferred-width: 0px;
                    Link {
                        x: 0;
                        width: min(self.preferred-width, parent.width);
                        height: parent.height;
                        text: root.track.album;
                        uri: root.track.album-uri;
                        kind: 0;
                        color: root.secondary;
                    }
                }
                Rectangle {
                    width: 32px;
                    if root.liked || ta.has-hover: IconButton {
                        icon: Icons.heart;
                        stroke: !root.liked;
                        active: root.liked;
                        size: 16px;
                        clicked => {
                            Api.toggle-like(root.track.uri);
                        }
                    }
                }
                if !root.compact: Text {
                    width: 44px;
                    text: root.track.duration;
                    color: Theme.subtext;
                    font-size: Theme.font-sm;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Barra deslizante para progreso y volumen. Con `busy` muestra un tramo que
// recorre la barra (canción cargando) en lugar del progreso.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <bool> live;
    in property <bool> busy;
    // Paso por cada muesca de la rueda del ratón (0 = sin rueda).
    in property <float> wheel-step;
    callback changed(float);
    out property <bool> dragging: ta.pressed;
    property <float> drag-value;
    property <float> shown: ta.pressed ? root.drag-value : max(0, min(1, root.value));
    property <bool> hot: (ta.has-hover || ta.pressed) && !root.busy;
    height: 16px;
    ta := TouchArea {
        mouse-cursor: root.busy ? default : pointer;
        scroll-event(e) => {
            if root.wheel-step <= 0 || e.delta-y == 0 {
                return reject;
            }
            root.changed(max(0, min(1, root.value + (e.delta-y > 0 ? root.wheel-step : -root.wheel-step))));
            return accept;
        }
        pointer-event(e) => {
            if !root.busy && e.kind == PointerEventKind.down {
                root.drag-value = max(0, min(1, self.mouse-x / root.width));
                if root.live {
                    root.changed(root.drag-value);
                }
            }
            if !root.busy && e.kind == PointerEventKind.up {
                root.changed(root.drag-value);
            }
        }
        moved => {
            if self.pressed && !root.busy {
                root.drag-value = max(0, min(1, self.mouse-x / root.width));
                if root.live {
                    root.changed(root.drag-value);
                }
            }
        }
    }
    Rectangle {
        y: (root.height - self.height) / 2;
        height: root.hot ? 6px : 4px;
        width: 100%;
        border-radius: self.height / 2;
        background: Theme.track;
        clip: root.busy;
        animate height { duration: Theme.fast; }
        if !root.busy: Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: parent.height / 2;
            background: root.hot ? Theme.accent-hover : Theme.accent;
        }
        if root.busy: Rectangle {
            property <float> t: Math.mod(animation-tick() / 1ms, 1400) / 1400;
            x: -self.width + self.t * (parent.width + self.width);
            width: max(24px, parent.width * 0.25);
            height: 100%;
            border-radius: parent.height / 2;
            background: Theme.accent;
        }
    }
    if root.hot: Rectangle {
        x: root.width * root.shown - 6px;
        y: (root.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 32px;
    border-radius: 16px;
    background: root.active ? (ta.has-hover ? Theme.accent-hover : Theme.accent) : ta.pressed ? #ffffff24 : ta.has-hover ? #ffffff1a : #ffffff0d;
    border-width: root.active ? 0px : 1px;
    border-color: Theme.border;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: root.active ? Theme.on-accent : Theme.text;
            font-size: Theme.font-md;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> primary: true;
    in property <length> pill-height: 48px;
    callback clicked;
    height: root.pill-height;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.elevated : root.primary ? (ta.pressed ? Theme.accent.darker(0.15) : ta.has-hover ? Theme.accent-hover : Theme.accent) : (ta.pressed ? #ffffff24 : ta.has-hover ? #ffffff14 : transparent);
    border-width: root.primary ? 0px : 1px;
    border-color: ta.has-hover ? Theme.subtext : Theme.border-strong;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: root.pill-height < 40px ? 16px : 28px;
        padding-right: self.padding-left;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 16px;
                height: 16px;
                data: root.icon;
                color: root.primary && root.enabled ? Theme.on-accent : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: !root.enabled ? Theme.muted : root.primary ? Theme.on-accent : Theme.text;
            font-size: root.pill-height < 40px ? Theme.font-sm : Theme.font-lg;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}
