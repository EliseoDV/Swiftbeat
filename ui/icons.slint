export component Icon {
    in property <string> data;
    in property <color> color: Theme.text;
    in property <bool> stroke: true;
    width: 24px;
    height: 24px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.data;
        fill: root.stroke ? transparent : root.color;
        stroke: root.stroke ? root.color : transparent;
        stroke-width: root.width / 12;
        stroke-line-cap: round;
    }
}
