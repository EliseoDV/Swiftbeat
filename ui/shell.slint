import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { BrandSymbol } from "brand.slint";
import { State, Api, Img, Fmt, Card, TrackRow, LyricLine } from "state.slint";
import { IconButton, CircleButton, PlayButton, Cover, TrackItem, Bar, Chip, EmptyState } from "components.slint";

component SearchBox inherits Rectangle {
    height: 48px;
    border-radius: 24px;
    background: input.has-focus ? Theme.elevated : ta.has-hover ? Theme.elevated-hover : Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : ta.has-hover ? Theme.border-strong : Theme.border;
    animate background, border-color { duration: Theme.fast; }
    ta := TouchArea {
        mouse-cursor: text;
        clicked => {
            input.focus();
            Api.go-search();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 20px;
                height: 20px;
                data: Icons.search;
                color: input.has-focus ? Theme.text : Theme.subtext;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                text <=> State.search-text;
                color: Theme.text;
                selection-background-color: Theme.accent-soft;
                font-size: Theme.font-md + 1px;
                single-line: true;
                edited => {
                    Api.search(self.text);
                }
            }
            if State.search-text == "": Text {
                x: 0;
                text: "¿Qué quieres escuchar?";
                color: Theme.muted;
                font-size: Theme.font-md + 1px;
            }
        }
        if State.search-text != "": VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.close;
                size: 16px;
                clicked => {
                    State.search-text = "";
                    Api.search("");
                    input.focus();
                }
            }
        }
    }
}

export component TopBar inherits HorizontalLayout {
    height: 48px;
    spacing: 8px;
    padding-left: 8px;
    padding-right: 8px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        horizontal-stretch: 1;
        // Ambos laterales parten de 0 para repartirse el espacio a partes iguales
        // y que inicio y búsqueda queden centrados en la ventana.
        min-width: 0px;
        preferred-width: 0px;
        // Solo el símbolo: el nombre ya está en el título de la ventana (guía de marca, §1).
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: logo-ta.has-hover ? Theme.surface : transparent;
                animate background { duration: Theme.fast; }
                BrandSymbol {
                    width: 26px;
                    color: Theme.brand;
                }
                logo-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Api.go-home();
                    }
                }
            }
        }
        Rectangle { width: 4px; }
        VerticalLayout {
            alignment: center;
            CircleButton {
                icon: Icons.chev-left;
                enabled: State.can-back;
                clicked => {
                    Api.back();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            CircleButton {
                icon: Icons.chev-right;
                enabled: State.can-forward;
                clicked => {
                    Api.forward();
                }
            }
        }
    }
    CircleButton {
        size: 48px;
        icon-size: 22px;
        icon: Icons.home;
        stroke: State.page != 0;
        active: State.page == 0;
        clicked => {
            Api.go-home();
        }
    }
    SearchBox {
        width: min(474px, root.width - 400px);
    }
    HorizontalLayout {
        horizontal-stretch: 1;
        min-width: 0px;
        preferred-width: 0px;
        alignment: end;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: State.page == 4 ? Theme.accent-soft : avatar-ta.has-hover ? Theme.elevated-hover : Theme.surface;
                animate background { duration: Theme.fast; }
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 15px;
                    clip: true;
                    background: Theme.accent;
                    Text {
                        text: State.user-initial;
                        color: Theme.on-accent;
                        font-size: Theme.font-md;
                        font-weight: 700;
                    }
                    if State.user-image != "": Image {
                        width: 100%;
                        height: 100%;
                        source: Img.get(State.user-image, -32, Img.epoch);
                        image-fit: cover;
                    }
                }
                avatar-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Api.go-settings();
                    }
                }
            }
        }
    }
}

component LibraryItem inherits Rectangle {
    in property <Card> card;
    property <bool> is-ctx: State.ctx-uri == root.card.uri;
    property <bool> is-open: State.coll-uri == root.card.uri || State.artist-uri == root.card.uri;
    height: 64px;
    border-radius: Theme.radius-row;
    background: root.is-open || ta.pressed ? Theme.row-active : ta.has-hover ? Theme.row-hover : transparent;
    animate background { duration: Theme.fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Api.navigate(root.card.kind, root.card.uri);
        }
        double-clicked => {
            Api.play-card(root.card.kind, root.card.uri);
        }
        HorizontalLayout {
            padding: 8px;
            spacing: 12px;
            Cover {
                width: 48px;
                height: 48px;
                url: root.card.image;
                px: 48;
                round: root.card.kind == 1;
                liked-tile: root.card.kind == 3;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.card.title;
                    color: root.is-ctx ? Theme.accent : Theme.text;
                    font-size: Theme.font-md + 1px;
                    font-weight: root.is-ctx ? 600 : 400;
                    overflow: elide;
                }
                Text {
                    text: root.card.subtitle;
                    color: Theme.subtext;
                    font-size: Theme.font-sm;
                    overflow: elide;
                }
            }
            if root.is-ctx && State.playing: VerticalLayout {
                alignment: center;
                Icon {
                    width: 16px;
                    height: 16px;
                    data: Icons.speaker;
                    color: Theme.accent;
                }
            }
        }
    }
    if root.is-open: Rectangle {
        x: 0;
        y: (root.height - self.height) / 2;
        width: 3px;
        height: 28px;
        border-radius: 2px;
        background: Theme.accent;
    }
}

export component Sidebar inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius-panel;
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 14px;
            padding-bottom: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon {
                    width: 22px;
                    height: 22px;
                    data: Icons.library;
                    color: Theme.subtext;
                }
            }
            Text {
                text: "Tu biblioteca";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            CircleButton {
                icon: Icons.plus;
                bg: Theme.panel;
                clicked => {
                    Api.create-playlist();
                }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-bottom: 10px;
            spacing: 8px;
            alignment: start;
            Chip {
                text: "Playlists";
                active: State.library-filter == 2;
                clicked => {
                    Api.set-library-filter(State.library-filter == 2 ? -1 : 2);
                }
            }
            Chip {
                text: "Álbumes";
                active: State.library-filter == 0;
                clicked => {
                    Api.set-library-filter(State.library-filter == 0 ? -1 : 0);
                }
            }
            Chip {
                text: "Artistas";
                active: State.library-filter == 1;
                clicked => {
                    Api.set-library-filter(State.library-filter == 1 ? -1 : 1);
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            vertical-stretch: 1;
            ListView {
                width: 100%;
                height: 100%;
                for c in State.library: LibraryItem {
                    x: 8px;
                    width: parent.width - 16px;
                    card: c;
                }
            }
            if State.library.length == 0: EmptyState {
                width: 100%;
                height: 100%;
                icon: Icons.library;
                title: State.library-filter == -1 ? "" : "Nada por aquí";
                body: State.library-filter == -1 ? "" : "No tienes elementos de este tipo en tu biblioteca.";
                busy: State.library-filter == -1;
            }
        }
    }
}

export component PlayerBar inherits Rectangle {
    property <float> last-volume: 0.7;
    height: 80px;
    background: Theme.panel;
    border-radius: Theme.radius-panel;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 16px;
        HorizontalLayout {
            width: 30%;
            spacing: 14px;
            alignment: start;
            if State.np-uri != "": VerticalLayout {
                alignment: center;
                Cover {
                    width: 56px;
                    height: 56px;
                    url: State.np-image;
                    px: 56;
                }
            }
            if State.np-uri == "": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: Theme.radius-cover;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    Icon {
                        width: 22px;
                        height: 22px;
                        data: Icons.note;
                        stroke: false;
                        color: Theme.muted;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                min-width: 0px;
                Text {
                    text: State.np-uri != "" ? State.np-title : "Nada sonando";
                    color: State.np-uri != "" ? (title-ta.has-hover ? #ffffff : Theme.text) : Theme.subtext;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    overflow: elide;
                    title-ta := TouchArea {
                        mouse-cursor: State.np-album-uri != "" ? pointer : default;
                        clicked => {
                            if State.np-album-uri != "" {
                                Api.navigate(0, State.np-album-uri);
                            }
                        }
                    }
                }
                Text {
                    text: State.np-uri != "" ? State.np-artists : "Elige una canción para empezar";
                    color: artist-ta.has-hover && State.np-artist-uri != "" ? Theme.text : Theme.subtext;
                    font-size: Theme.font-xs;
                    overflow: elide;
                    artist-ta := TouchArea {
                        mouse-cursor: State.np-artist-uri != "" ? pointer : default;
                        clicked => {
                            if State.np-artist-uri != "" {
                                Api.navigate(1, State.np-artist-uri);
                            }
                        }
                    }
                }
            }
            if State.np-uri != "": VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.heart;
                    property <bool> liked: Api.is-liked(State.np-uri, State.liked-epoch);
                    stroke: !self.liked;
                    active: self.liked;
                    size: 16px;
                    clicked => {
                        Api.toggle-like(State.np-uri);
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.shuffle;
                        active: State.shuffle;
                        show-dot: true;
                        clicked => {
                            Api.toggle-shuffle();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.prev;
                        stroke: false;
                        base: Theme.text;
                        clicked => {
                            Api.prev();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PlayButton {
                        size: 38px;
                        bg: Theme.text;
                        hover-bg: #ffffff;
                        playing: State.playing;
                        clicked => {
                            Api.toggle-play();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.next;
                        stroke: false;
                        base: Theme.text;
                        clicked => {
                            Api.next();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: rep.width;
                        height: rep.height;
                        rep := IconButton {
                            icon: Icons.repeat;
                            active: State.repeat > 0;
                            show-dot: true;
                            clicked => {
                                Api.cycle-repeat();
                            }
                        }
                        if State.repeat == 2: Rectangle {
                            x: parent.width - 13px;
                            y: 2px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: Theme.accent;
                            Text {
                                text: "1";
                                font-size: 8px;
                                font-weight: 800;
                                color: Theme.on-accent;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    width: 40px;
                    text: Fmt.time(State.np-position);
                    color: Theme.subtext;
                    font-size: Theme.font-xs;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                progress := Bar {
                    horizontal-stretch: 1;
                    busy: State.buffering;
                    value: State.np-duration > 0 ? State.np-position / State.np-duration : 0;
                    changed(v) => {
                        State.np-position = v * State.np-duration;
                        Api.seek(v * State.np-duration);
                    }
                }
                Text {
                    width: 40px;
                    text: Fmt.time(State.np-duration);
                    color: Theme.subtext;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            width: 30%;
            alignment: end;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.mic;
                    active: State.right-panel == 2;
                    show-dot: true;
                    clicked => {
                        Api.set-right-panel(State.right-panel == 2 ? 0 : 2);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.queue;
                    active: State.right-panel == 1;
                    show-dot: true;
                    clicked => {
                        Api.set-right-panel(State.right-panel == 1 ? 0 : 1);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: State.volume <= 0.001 ? Icons.mute : Icons.volume;
                    clicked => {
                        if State.volume > 0.001 {
                            root.last-volume = State.volume;
                            State.volume = 0;
                        } else {
                            State.volume = root.last-volume > 0.01 ? root.last-volume : 0.5;
                        }
                        Api.set-volume(State.volume);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Bar {
                    width: 100px;
                    live: true;
                    wheel-step: 0.05;
                    value: State.volume;
                    changed(v) => {
                        State.volume = v;
                        Api.set-volume(v);
                    }
                }
            }
        }
    }
}

component LyricsView inherits Rectangle {
    property <int> active: State.lyrics-active;
    changed active => {
        lv.content-y = min(0px, -(root.active * 56px) + lv.visible-height / 3);
    }
    if State.lyrics.length == 0: EmptyState {
        width: 100%;
        height: 100%;
        icon: Icons.mic;
        body: State.lyrics-status;
        busy: State.lyrics-status == "Cargando letra…";
    }
    lv := ListView {
        visible: State.lyrics.length > 0;
        for line[i] in State.lyrics: Rectangle {
            height: 56px;
            Text {
                x: 4px;
                width: parent.width - 8px;
                height: 100%;
                text: line.text;
                font-size: 19px;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
                color: i == root.active ? Theme.text : line-ta.has-hover ? Theme.subtext : i < root.active ? #ffffff70 : Theme.muted;
                animate color { duration: Theme.normal; }
            }
            line-ta := TouchArea {
                mouse-cursor: line.start >= 0 ? pointer : default;
                clicked => {
                    if line.start >= 0 {
                        State.np-position = line.start;
                        Api.seek(line.start);
                    }
                }
            }
        }
    }
}

export component RightPanel inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius-panel;
    clip: true;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            padding-left: 4px;
            Text {
                text: State.right-panel == 1 ? "Cola" : "Letra";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            CircleButton {
                icon: Icons.close;
                bg: Theme.panel;
                clicked => {
                    Api.set-right-panel(0);
                }
            }
        }
        if State.right-panel == 1: VerticalLayout {
            spacing: 10px;
            if State.np-uri != "": Text {
                text: "Sonando ahora";
                font-size: Theme.font-sm;
                font-weight: 600;
                color: Theme.subtext;
            }
            if State.np-uri != "": Rectangle {
                height: 64px;
                border-radius: Theme.radius-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 12px;
                    Cover {
                        width: 48px;
                        height: 48px;
                        url: State.np-image;
                        px: 48;
                        radius: 4px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: State.np-title;
                            color: Theme.accent;
                            font-size: Theme.font-md + 1px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: State.np-artists;
                            color: Theme.subtext;
                            font-size: Theme.font-sm;
                            overflow: elide;
                        }
                    }
                    if State.playing: VerticalLayout {
                        alignment: center;
                        Icon {
                            width: 16px;
                            height: 16px;
                            data: Icons.bars;
                            color: Theme.accent;
                        }
                    }
                }
            }
            if State.queue.length > 0: Text {
                text: "A continuación";
                font-size: Theme.font-sm;
                font-weight: 600;
                color: Theme.subtext;
            }
            if State.queue.length > 0: ListView {
                for t in State.queue: TrackItem {
                    track: t;
                    source: 3;
                    compact: true;
                    show-album: false;
                }
            }
            if State.queue.length == 0: EmptyState {
                vertical-stretch: 1;
                icon: Icons.queue;
                title: "No hay nada en cola";
                body: "Haz clic derecho en una canción y elige «Añadir a la cola».";
            }
        }
        if State.right-panel == 2: LyricsView {
            vertical-stretch: 1;
        }
    }
}
