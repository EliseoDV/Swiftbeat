import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { State, Api, Img, Fmt, Card, TrackRow, LyricLine } from "state.slint";
import { IconButton, CircleButton, PlayButton, Cover, TrackItem, Bar, Chip } from "components.slint";

component SearchBox inherits Rectangle {
    height: 48px;
    border-radius: 24px;
    background: ta.has-hover || input.has-focus ? Theme.elevated-hover : Theme.elevated;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.text;
    ta := TouchArea {
        clicked => {
            input.focus();
            Api.go-search();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 22px;
                height: 22px;
                data: Icons.search;
                color: input.has-focus ? Theme.text : Theme.subtext;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                text <=> State.search-text;
                color: Theme.text;
                font-size: 15px;
                single-line: true;
                edited => {
                    Api.search(self.text);
                }
            }
            if State.search-text == "": Text {
                x: 0;
                text: "¿Qué quieres reproducir?";
                color: Theme.subtext;
                font-size: 15px;
            }
        }
        if State.search-text != "": VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.close;
                size: 16px;
                clicked => {
                    State.search-text = "";
                    Api.search("");
                    input.focus();
                }
            }
        }
    }
}

export component TopBar inherits HorizontalLayout {
    height: 48px;
    spacing: 8px;
    padding-left: 8px;
    padding-right: 8px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        horizontal-stretch: 1;
        VerticalLayout {
            alignment: center;
            CircleButton {
                icon: Icons.chev-left;
                enabled: State.can-back;
                clicked => {
                    Api.back();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            CircleButton {
                icon: Icons.chev-right;
                enabled: State.can-forward;
                clicked => {
                    Api.forward();
                }
            }
        }
    }
    CircleButton {
        size: 48px;
        icon-size: 24px;
        icon: Icons.home;
        stroke: State.page != 0;
        active: State.page == 0;
        bg: Theme.elevated;
        clicked => {
            Api.go-home();
        }
    }
    SearchBox {
        width: min(474px, root.width - 360px);
    }
    HorizontalLayout {
        horizontal-stretch: 1;
        alignment: end;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: avatar-ta.has-hover ? #2a2a2a : #1f1f1f;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    clip: true;
                    background: #f573a0;
                    Text {
                        text: State.user-initial;
                        color: #000000;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    if State.user-image != "": Image {
                        width: 100%;
                        height: 100%;
                        source: Img.get(State.user-image, 32, Img.epoch);
                        image-fit: cover;
                    }
                }
                avatar-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Api.go-settings();
                    }
                }
            }
        }
    }
}

component LibraryItem inherits Rectangle {
    in property <Card> card;
    property <bool> is-ctx: State.ctx-uri == root.card.uri;
    property <bool> is-open: State.coll-uri == root.card.uri || State.artist-uri == root.card.uri;
    height: 64px;
    border-radius: 6px;
    background: root.is-open ? Theme.row-active : ta.has-hover ? Theme.row-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Api.navigate(root.card.kind, root.card.uri);
        }
        double-clicked => {
            Api.play-card(root.card.kind, root.card.uri);
        }
        HorizontalLayout {
            padding: 8px;
            spacing: 12px;
            Cover {
                width: 48px;
                height: 48px;
                url: root.card.image;
                px: 48;
                round: root.card.kind == 1;
                liked-tile: root.card.kind == 3;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.card.title;
                    color: root.is-ctx ? Theme.accent : Theme.text;
                    font-size: 15px;
                    overflow: elide;
                }
                Text {
                    text: root.card.subtitle;
                    color: Theme.subtext;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            if root.is-ctx && State.playing: VerticalLayout {
                alignment: center;
                Icon {
                    width: 16px;
                    height: 16px;
                    data: Icons.speaker;
                    color: Theme.accent;
                }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    background: Theme.panel;
    border-radius: 8px;
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 12px;
            padding-bottom: 8px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon {
                    width: 24px;
                    height: 24px;
                    data: Icons.library;
                    color: Theme.subtext;
                }
            }
            Text {
                text: "Tu biblioteca";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            CircleButton {
                icon: Icons.plus;
                bg: Theme.panel;
                clicked => {
                    Api.create-playlist();
                }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-bottom: 8px;
            spacing: 8px;
            alignment: start;
            Chip {
                text: "Playlists";
                active: State.library-filter == 2;
                clicked => {
                    Api.set-library-filter(State.library-filter == 2 ? -1 : 2);
                }
            }
            Chip {
                text: "Álbumes";
                active: State.library-filter == 0;
                clicked => {
                    Api.set-library-filter(State.library-filter == 0 ? -1 : 0);
                }
            }
            Chip {
                text: "Artistas";
                active: State.library-filter == 1;
                clicked => {
                    Api.set-library-filter(State.library-filter == 1 ? -1 : 1);
                }
            }
        }
        ListView {
            for c in State.library: LibraryItem {
                x: 8px;
                width: parent.width - 16px;
                card: c;
            }
        }
    }
}

export component PlayerBar inherits HorizontalLayout {
    property <float> last-volume: 0.7;
    height: 72px;
    padding-left: 8px;
    padding-right: 8px;
    HorizontalLayout {
        width: 30%;
        spacing: 14px;
        alignment: start;
        if State.np-uri != "": VerticalLayout {
            alignment: center;
            Cover {
                width: 56px;
                height: 56px;
                url: State.np-image;
                px: 56;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: State.np-title;
                color: title-ta.has-hover ? Theme.text : Theme.text;
                font-size: 14px;
                overflow: elide;
                title-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if State.np-album-uri != "" {
                            Api.navigate(0, State.np-album-uri);
                        }
                    }
                }
            }
            Text {
                text: State.np-artists;
                color: artist-ta.has-hover ? Theme.text : Theme.subtext;
                font-size: 12px;
                overflow: elide;
                artist-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if State.np-artist-uri != "" {
                            Api.navigate(1, State.np-artist-uri);
                        }
                    }
                }
            }
        }
        if State.np-uri != "": VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.heart;
                property <bool> liked: Api.is-liked(State.np-uri, State.liked-epoch);
                stroke: !self.liked;
                active: self.liked;
                size: 16px;
                clicked => {
                    Api.toggle-like(State.np-uri);
                }
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            IconButton {
                icon: Icons.shuffle;
                active: State.shuffle;
                show-dot: true;
                clicked => {
                    Api.toggle-shuffle();
                }
            }
            IconButton {
                icon: Icons.prev;
                stroke: false;
                clicked => {
                    Api.prev();
                }
            }
            VerticalLayout {
                alignment: center;
                PlayButton {
                    size: 32px;
                    bg: #ffffff;
                    hover-bg: #f0f0f0;
                    playing: State.playing;
                    clicked => {
                        Api.toggle-play();
                    }
                }
            }
            IconButton {
                icon: Icons.next;
                stroke: false;
                clicked => {
                    Api.next();
                }
            }
            Rectangle {
                width: rep.width;
                height: rep.height;
                rep := IconButton {
                    icon: Icons.repeat;
                    active: State.repeat > 0;
                    show-dot: true;
                    clicked => {
                        Api.cycle-repeat();
                    }
                }
                if State.repeat == 2: Rectangle {
                    x: parent.width - 13px;
                    y: 2px;
                    width: 11px;
                    height: 11px;
                    border-radius: 6px;
                    background: Theme.accent;
                    Text {
                        text: "1";
                        font-size: 8px;
                        font-weight: 800;
                        color: #000000;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                width: 40px;
                text: Fmt.time(State.np-position);
                color: Theme.subtext;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            progress := Bar {
                horizontal-stretch: 1;
                value: State.np-duration > 0 ? State.np-position / State.np-duration : 0;
                changed(v) => {
                    State.np-position = v * State.np-duration;
                    Api.seek(v * State.np-duration);
                }
            }
            Text {
                width: 40px;
                text: Fmt.time(State.np-duration);
                color: Theme.subtext;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
    HorizontalLayout {
        width: 30%;
        alignment: end;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.mic;
                active: State.right-panel == 2;
                show-dot: true;
                clicked => {
                    Api.set-right-panel(State.right-panel == 2 ? 0 : 2);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.queue;
                active: State.right-panel == 1;
                show-dot: true;
                clicked => {
                    Api.set-right-panel(State.right-panel == 1 ? 0 : 1);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: State.volume <= 0.001 ? Icons.mute : Icons.volume;
                clicked => {
                    if State.volume > 0.001 {
                        root.last-volume = State.volume;
                        State.volume = 0;
                    } else {
                        State.volume = root.last-volume > 0.01 ? root.last-volume : 0.5;
                    }
                    Api.set-volume(State.volume);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Bar {
                width: 96px;
                live: true;
                wheel-step: 0.05;
                value: State.volume;
                changed(v) => {
                    State.volume = v;
                    Api.set-volume(v);
                }
            }
        }
    }
}

component LyricsView inherits Rectangle {
    property <int> active: State.lyrics-active;
    changed active => {
        lv.content-y = min(0px, -(root.active * 52px) + lv.visible-height / 3);
    }
    if State.lyrics.length == 0: Text {
        text: State.lyrics-status;
        color: Theme.subtext;
        font-size: 14px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
    lv := ListView {
        visible: State.lyrics.length > 0;
        for line[i] in State.lyrics: Rectangle {
            height: 52px;
            Text {
                width: 100%;
                height: 100%;
                text: line.text;
                font-size: 18px;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
                color: i == root.active ? Theme.text : i < root.active ? #ffffff80 : #ffffff4d;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if line.start >= 0 {
                        State.np-position = line.start;
                        Api.seek(line.start);
                    }
                }
            }
        }
    }
}

export component RightPanel inherits Rectangle {
    background: Theme.panel;
    border-radius: 8px;
    clip: true;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            padding-left: 4px;
            Text {
                text: State.right-panel == 1 ? "Cola" : "Letra";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            CircleButton {
                icon: Icons.close;
                bg: Theme.panel;
                clicked => {
                    Api.set-right-panel(0);
                }
            }
        }
        if State.right-panel == 1: VerticalLayout {
            spacing: 8px;
            Text {
                text: "Sonando ahora";
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
            }
            if State.np-uri != "": HorizontalLayout {
                spacing: 10px;
                height: 56px;
                padding-left: 8px;
                VerticalLayout {
                    alignment: center;
                    Cover {
                        width: 40px;
                        height: 40px;
                        url: State.np-image;
                        px: 40;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: State.np-title;
                        color: Theme.accent;
                        font-size: 15px;
                        overflow: elide;
                    }
                    Text {
                        text: State.np-artists;
                        color: Theme.subtext;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
            }
            Text {
                text: State.queue.length > 0 ? "A continuación" : "No hay nada en cola";
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
            }
            ListView {
                for t in State.queue: TrackItem {
                    track: t;
                    source: 3;
                    compact: true;
                    show-album: false;
                }
            }
        }
        if State.right-panel == 2: LyricsView {
            vertical-stretch: 1;
        }
    }
}
