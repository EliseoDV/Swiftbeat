// Paleta oscura inspirada en el cliente de escritorio.
export global Theme {
    out property <color> bg: #000000;
    out property <color> panel: #121212;
    out property <color> card-hover: #1f1f1f;
    out property <color> elevated: #1f1f1f;
    out property <color> elevated-hover: #2a2a2a;
    out property <color> row-hover: #ffffff1a;
    out property <color> row-active: #ffffff24;
    out property <color> text: #ffffff;
    out property <color> subtext: #b3b3b3;
    out property <color> muted: #6a6a6a;
    out property <color> accent: #8486c4;
    out property <color> accent-hover: #9a9cd3;
    out property <color> track: #4d4d4d;
    out property <color> toast: #2e77d0;
}
